//IL MANQUE A REDIGER UN RAPPORT UNIQUEMNT QUAND UNE DIFFRENCE EST NOTABLE

//----Methode pour faire la comparaison---------------------------------------------

def compareReponse(jsonObject7, jsonObject21, rapport){
	def difference = [] // Liste qui va regrouper les differences entre les 2 JsonObject correspondant aux reponse des services du middleware
	//difference.add("\n") // Pour affichage empeche de faire ecrire rapport car remplit avec un espace donc plus vide
	if(jsonObject7 instanceof Map && jsonObject21 instanceof Map){
		def keyJdk7 = jsonObject7.keySet()
		def keyJdk21 = jsonObject21.keySet()

		// Clé presente que dans Jdk7
		def OnlyInJdk7 = new HashSet<>(keyJdk7)
		OnlyInJdk7.removeAll(keyJdk21)
		if(OnlyInJdk7.isEmpty() == false){
			difference.add("Cles manquantes dans Jdk21 : "  + OnlyInJdk7+ "\n")
		}

		//Clé présente que dans Jdk21
		def OnlyInJdk21 = new HashSet<>(keyJdk21)
		OnlyInJdk21.removeAll(keyJdk7)
		if(OnlyInJdk21.isEmpty() == false){
			difference.add("Cles manquantes dans Jdk7 : " + OnlyInJdk21 + "\n")
		}
		
		//Quand on a les mêmes clés on doit verrifier les valeurs de celle ci
		def inter = keyJdk7.intersect(keyJdk21)
		for (key in inter){
			def valeurJdk7 = jsonObject7[key]
			def valeurJdk21 = jsonObject21[key]

			// Si on a une Map 
			//on fait une récursion sur les valeurs et on continue pour ne pas comparer les structure ebntre elle 
			// On verrifie compare uniquemet les clés et non la structure en elle meme +  d'explication voir la documentation
            	if (valeurJdk7 instanceof Map && valeurJdk21 instanceof Map) {
                	difference.addAll(compareReponse(valeurJdk7, valeurJdk21,rapport))
               	continue
            	}

            	// Si on a une Liste
            	else if (valeurJdk7 instanceof List && valeurJdk21 instanceof List) {
                	if (valeurJdk7.size() != valeurJdk21.size()){
                    	difference.add("TAILLE LISTE différente : JDK7= ${valeurJdk7.size()} / JDK21= ${valeurJdk21.size()}\n")
                	}
                	else {
                    	for (int i = 0; i < valeurJdk7.size(); i++) {
    							difference.addAll(compareReponse(valeurJdk7[i], valeurJdk21[i],rapport))
					}
                	}
               	continue
            	}
            	else{
            		//Compare les types des variables
            		if (valeurJdk7.getClass() != valeurJdk21.getClass()){
					def typeJdk7 = valeurJdk7.getClass()
					def typeJdk21 = valeurJdk21.getClass()
					difference.add("ERREUR DE TYPE  : JDK 7 : ${valeurJdk7} est de type ${typeJdk7}  -->  JDK 21 : ${valeurJdk21} est de type ${typeJdk21}\n")
				}
				//Compare la valeur SI ils ont le même types
				else if(valeurJdk21 != valeurJdk7){
					difference.add("ERREUR DE VALEUR  : JDK7 : ${valeurJdk7}  -->  JDK21 : ${valeurJdk21}\n")
				}  
				continue          		
            	}	
            	
            	
		}	
	}
	else if (jsonObject7 != jsonObject21){
		difference.add("TYPES INCOMPATIBLES : JDK7 de type : ${jsonObject7.getClass()}et JDK21 de type : ${jsonObject21.getClass()}\n")
	}

	// On parcour la liste et on rajoute chaque elemnets de la liste avec des suats à la ligne
	/*
	for(ligne in difference){
			rapport.append(ligne + "\n")
		}
		*/	
	return  difference
}

def ecrireRapport(rapport,differences) {

	differences.each { ligne -> rapport.append(ligne) }
     if (differences.size() == 0) {
     	rapport.delete()
     }  
}
