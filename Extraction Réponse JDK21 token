// --------------------------------------------- Boucle sur tous les services -------------
for (testStep in testRunner.testCase.getTestStepList()) {

    if (!(testStep instanceof RestTestRequestStep)) continue

    def stepName = testStep.getName()
    log.info("Traitement de : " + stepName)

    // ---------- Construction du body JSON ------------------------------------------------
    if (paramsMap.containsKey(stepName)) {
        def prefix = paramsMap[stepName]

        def serviceParams = [:]
        for (entry in config) {
            def key   = entry.key
            def value = entry.value
            if (key.startsWith("${prefix}.")) {
                def cleanKey = key.replace("${prefix}.", "")
                serviceParams[cleanKey] = value
            }
        }

        def nestedMap = [:]
        for (entry in serviceParams) {
            def key   = entry.key
            def value = entry.value
            def parts = key.split("\\.")
            def current = nestedMap

            for (int i = 0; i < parts.length - 1; i++) {
                def part = parts[i]
                if (!current.containsKey(part)) {
                    current[part] = [:]
                }
                current = current[part]
            }

            current[parts[parts.length - 1]] = convertValue(value)
        }

        def jsonBody   = groovy.json.JsonOutput.toJson(nestedMap)
        def jsonPretty = groovy.json.JsonOutput.prettyPrint(jsonBody)
        log.info("  Requête JSON : " + jsonPretty)

        testStep.httpRequest.setRequestContent(jsonBody)

    } else {
        log.info("  Aucun paramètre trouvé pour ce step")
    }

    // ---------- Injection des headers + cookie -------------------------------------------
    def headers = new com.eviware.soapui.support.types.StringToStringMap()
    headers.put("X_WASSUP_ULV",    config.getProperty("ULV"))
    headers.put("X_WASSUP_MSISDN", config.getProperty("MSISDN"))

    if (stepName != "Loginwithcontext 1 - Request 1") {
        headers.put("Cookie", cookie)
        testStep.httpRequest.setRequestHeaders(headers)
        testRunner.runTestStepByName(stepName)
    } else {
        testStep.httpRequest.setRequestHeaders(headers)
    }

    // ---------- Export de la réponse -----------------------------------------------------
    def response = testRunner.testCase.getTestStepByName(stepName).httpRequest.response?.responseContent

    def outputPath = "C:/Users/cswp5655/OneDrive - orange.com/Documents/Comparatoo/ReponseJson/Services-Middelaware-JDK211/" + stepName + ".json"
    def file = new File(outputPath)
    file.parentFile.mkdirs()

    if (response != null) {
        file.text = response
    } else {
        file.text = '{"step":"' + stepName + '","warning":"Aucune réponse"}'
    }

    log.info("  Réponse exportée : " + response)
}

log.info("Tous les services ont été exécutés")
