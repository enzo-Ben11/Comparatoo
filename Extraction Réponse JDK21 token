// ------------------------- Conversion de type --------------------------------------------
def convertValue = { String raw ->
    if (raw == null || raw.startsWith("[null]")) return null
    if (raw.startsWith("[int]"))     return raw.replace("[int]", "").toInteger()
    if (raw.startsWith("[bool]"))    return raw.replace("[bool]", "").toBoolean()
    if (raw.startsWith("[list]"))    return raw.replace("[list]", "").split(",").collect { it.trim() }
    if (raw.startsWith("[listint]")) return raw.replace("[listint]", "").split(",").collect { it.trim().toInteger() }
    return raw
}

