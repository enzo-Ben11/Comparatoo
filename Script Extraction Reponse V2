// --------------------------------------------- Boucle sur tous les services contenu dasn le test Case------------------------

for (testStep in testRunner.testCase.getTestStepList()) {

    if (!(testStep instanceof RestTestRequestStep)) continue // recupere uniquement les requêtes presente dasn le testSTEP

    def stepName = testStep.getName()
    log.info("Traitement de " + stepName)

    //Extraire les params et construire le JSON imbriqué
    if (paramsMap.containsKey(stepName)) {
        def prefix = paramsMap[stepName]

	   //Parcour le fichier config et insere dans la Map service params les clés et valeurs de la requête Json
        def serviceParams = [:]        
        for (entry in config) {
	   	def key = entry.key
        	def value = entry.value
    		if (key.startsWith("${prefix}.")) {
        		def cleanKey = key.replace("${prefix}.", "")
        		serviceParams[cleanKey] = value
    		}
	   }
	   

        def nestedMap = [:]
	   for (entry in serviceParams) {   
    	   	def key = entry.key
        	def value = entry.value
        	def parts = key.split("\\.")
        	def current = nestedMap

    // Parcours des parties sauf la dernière
    			for (int i = 0; i < parts.length - 1; i++) {
        			def part = parts[i]
        			if (!current.containsKey(part)) {
            			current[part] = [:]
        			}
        			current = current[part]
    			}

    // Assigner la valeur à la dernière clé
    		current[parts[parts.length - 1]] = convertValue(value)
	   }


        def jsonBody   = groovy.json.JsonOutput.toJson(nestedMap)
        def jsonPretty = groovy.json.JsonOutput.prettyPrint(jsonBody)
        log.info("  Requête JSON  : " + jsonPretty)

        testStep.httpRequest.setRequestContent(jsonBody)

    } else {
        log.info("  Aucun paramètre")
    }

//---------------------------------------------------------------------------------------------------------------------------------------------------------

//--------------------------------- Injecter les headers communs ------------------------------------------------------------------------------------------


